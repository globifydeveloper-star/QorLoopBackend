generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  catalogue_manager
  analyst
}

model Tenant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  hostname           String              @unique
  status             String              @default("active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  users              User[]
  memberships        Membership[]
  sessions           Session[]
  invitations        Invitation[]
  resetTokens        PasswordReset[]
  recoveryCodes      RecoveryCode[]
  stores             Store[]
  settings           TenantSettings?
  auditEvents        AuditEvent[]
  outbox             EmailOutbox[]
  tenantMarketplaces TenantMarketplace[]
  categories         Category[]
  categoryMappings   CategoryMapping[]
  products           Product[]
  listings           Listing[]

  uploads               Upload[]
  uploadRows            UploadRow[]
  uploadErrors          UploadError[]
  pricingSettings       PricingSettings?
  categoryPriceRules    CategoryPriceRule[]
  productPriceRules     ProductPriceRule[]
  productOffers         ProductOffer[]
  marketplacePriceRules MarketplacePriceRule[]
  reconRows             ReconRow[]
  reconSummaries        ReconSummary[]
  generatedFiles        GeneratedFile[]
  notifications         Notification[]
  inputTemplates        InputTemplate[]

  @@map("tenants")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  email               String
  name                String
  passwordHash        String          @map("password_hash")
  emailVerifiedAt     DateTime        @map("email_verified_at") @db.Timestamptz
  mfaSecret           String?         @map("mfa_secret")
  pendingMfaSecret    String?         @map("pending_mfa_secret")
  pendingMfaExpiresAt DateTime?       @map("pending_mfa_expires_at") @db.Timestamptz
  lastTotpStep        Int?            @map("last_totp_step")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  memberships         Membership[]
  sessions            Session[]
  resetTokens         PasswordReset[]
  recoveryCodes       RecoveryCode[]
  uploads             Upload[]
  generatedFiles      GeneratedFile[]
  notifications       Notification[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [tenantId, userId], references: [tenantId, id])
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, role, active])
  @@map("memberships")
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String
  pendingEmail String?   @map("pending_email")
  role         Role
  tokenHash    String    @unique @map("token_hash")
  invitedBy    String?   @map("invited_by") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, pendingEmail])
  @@index([tenantId, email])
  @@map("invitations")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [tenantId, userId], references: [tenantId, id])
  tokenHash  String   @unique @map("token_hash")
  csrfHash   String   @map("csrf_hash")
  assurance  String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, userId])
  @@map("password_resets")
}

model RecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  userId   String    @map("user_id") @db.Uuid
  user     User      @relation(fields: [tenantId, userId], references: [tenantId, id])
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz

  @@unique([tenantId, userId, codeHash])
  @@map("recovery_codes")
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("stores")
}

model TenantSettings {
  id                String  @id @default(uuid()) @db.Uuid
  tenantId          String  @unique @map("tenant_id") @db.Uuid
  tenant            Tenant  @relation(fields: [tenantId], references: [id])
  mfaRequiredForAll Boolean @default(false) @map("mfa_required_for_all")
  analystCanExport  Boolean @default(true) @map("analyst_can_export")
  priceTolerance    Decimal @default(0) @map("price_tolerance") @db.Decimal(12, 3)
  stockThreshold    Int     @default(0) @map("stock_threshold")
  staleHours        Int     @default(12) @map("stale_hours")

  @@map("tenant_settings")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entityId  String?  @map("entity_id") @db.Uuid
  requestId String?  @map("request_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("audit_events")
}

model EmailOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  dedupeKey     String    @map("dedupe_key")
  sealedMessage String    @map("sealed_message")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, dedupeKey])
  @@index([deliveredAt, availableAt])
  @@map("email_outbox")
}

// ───────────────────────── Marketplaces (global reference + per-tenant switch) ─────────────────────────
// Global tables carry no tenant_id on purpose: they are shared by every tenant in a future SaaS deployment.

model Marketplace {
  id                 String              @id // talabat | snoonu | rafeeq | keeta
  name               String
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  tenantMarketplaces TenantMarketplace[]

  @@map("marketplaces")
}

model TenantMarketplace {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  marketplaceId String      @map("marketplace_id")
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, marketplaceId])
  @@map("tenant_marketplaces")
}

// ───────────────────────── Catalogue ─────────────────────────

model Category {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  parentId  String?           @map("parent_id") @db.Uuid
  parent    Category?         @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id])
  children  Category[]        @relation("CategoryTree")
  nameEn    String            @map("name_en")
  nameAr    String?           @map("name_ar")
  sort      Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  mappings  CategoryMapping[]
  products  Product[]         @relation("ProductCategory")

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@map("categories")
}

model CategoryMapping {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  categoryId          String   @map("category_id") @db.Uuid
  category            Category @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  marketplaceId       String   @map("marketplace_id")
  marketplaceCategory String   @map("marketplace_category")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, categoryId, marketplaceId])
  @@map("category_mappings")
}

model Product {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  barcode           String
  normalizedBarcode String            @map("normalized_barcode")
  sku               String?
  // owned by the ERP file (overwritten on every ERP upload)
  nameEn            String            @map("name_en")
  brand             String?
  size              String?
  erpCategory       String?           @map("erp_category")
  erpPrice          Decimal           @map("erp_price") @db.Decimal(12, 3)
  costPrice         Decimal?          @map("cost_price") @db.Decimal(12, 3)
  erpStock          Int               @default(0) @map("erp_stock")
  erpActive         Boolean           @default(true) @map("erp_active")
  inLatestErpFile   Boolean           @default(true) @map("in_latest_erp_file")
  // owned by Qorloop (never overwritten by an upload)
  nameAr            String?           @map("name_ar")
  categoryId        String?           @map("category_id") @db.Uuid
  category          Category?         @relation("ProductCategory", fields: [tenantId, categoryId], references: [tenantId, id])
  subcategoryId     String?           @map("subcategory_id") @db.Uuid
  imageKey          String?           @map("image_key")
  status            String            @default("new")
  updatedBy         String?           @map("updated_by")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  listings          Listing[]
  priceRule         ProductPriceRule?
  offers            ProductOffer[]
  reconRows         ReconRow[]

  @@unique([tenantId, normalizedBarcode])
  @@unique([tenantId, id])
  @@index([tenantId, sku])
  @@index([tenantId, status])
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_en_trgm_idx")
  @@map("products")
}

model Listing {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  productId            String?  @map("product_id") @db.Uuid // null = unmatched row (feeds data quality)
  product              Product? @relation(fields: [tenantId, productId], references: [tenantId, id])
  marketplaceId        String   @map("marketplace_id")
  marketplaceProductId String   @map("marketplace_product_id")
  barcodes             String[]
  name                 String?
  price                Decimal  @db.Decimal(12, 3)
  available            Boolean
  uploadId             String?  @map("upload_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, marketplaceId, marketplaceProductId])
  @@index([tenantId, marketplaceId, productId])
  @@map("listings")
}

// ───────────────────────── Pricing ─────────────────────────

model PricingSettings {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @unique @map("tenant_id") @db.Uuid
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  defaultRuleMode         String   @default("same") @map("default_rule_mode")
  defaultRuleValue        Decimal  @default(0) @map("default_rule_value") @db.Decimal(12, 3)
  rounding                String   @default("exact")
  perMarketplaceEnabled   Boolean  @default(false) @map("per_marketplace_enabled")
  compareReferenceDefault String   @default("marketplace") @map("compare_reference_default")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("pricing_settings")
}

model CategoryPriceRule {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  categoryId    String   @map("category_id") @db.Uuid
  subcategoryId String?  @map("subcategory_id") @db.Uuid
  mode          String
  value         Decimal  @db.Decimal(12, 3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, categoryId, subcategoryId])
  @@map("category_price_rules")
}

model ProductPriceRule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [tenantId, productId], references: [tenantId, id])
  mode      String
  value     Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, productId])
  @@map("product_price_rules")
}

model ProductOffer {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  productId  String    @map("product_id") @db.Uuid
  product    Product   @relation(fields: [tenantId, productId], references: [tenantId, id])
  price      Decimal   @db.Decimal(12, 3)
  validFrom  DateTime? @map("valid_from") @db.Timestamptz
  validUntil DateTime? @map("valid_until") @db.Timestamptz // Q5: optional "valid until"
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, productId])
  @@map("product_offers")
}

model MarketplacePriceRule {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  marketplaceId String   @map("marketplace_id")
  productId     String?  @map("product_id") @db.Uuid
  mode          String
  value         Decimal  @db.Decimal(12, 3)
  rounding      String   @default("exact")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, marketplaceId, productId])
  @@map("marketplace_price_rules")
}

// ───────────────────────── Uploads ─────────────────────────

model InputTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid // null = built-in
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  source    String // erp | marketplace id
  name      String
  version   Int      @default(1)
  fields    Json // Qorloop field -> source header
  signature String[] // headers that identify the layout
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, source, name, version])
  @@index([tenantId, source])
  @@map("input_templates")
}

model Upload {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  source            String // erp | talabat | snoonu | rafeeq | keeta
  fileName          String        @map("file_name")
  contentType       String?       @map("content_type")
  size              Int // declared size in bytes; re-verified against storage on confirm
  storageKey        String        @map("storage_key")
  checksumSha256    String?       @map("checksum_sha256")
  contains          String        @default("full") // full | partial
  templateId        String?       @map("template_id") @db.Uuid
  templateVersion   Int?          @map("template_version")
  uploadedById      String        @map("uploaded_by_id") @db.Uuid
  uploadedBy        User          @relation(fields: [tenantId, uploadedById], references: [tenantId, id])
  status            String        @default("uploading")
  step              String?
  progress          Int           @default(0)
  headers           Json?
  sheetName         String?       @map("sheet_name")
  mapping           Json? // field -> header confirmed by the user (or from a detected file mapping)
  revision          Int           @default(0)
  mappingSuggestion Json?         @map("mapping_suggestion")
  summary           Json?
  errorMessage      String?       @map("error_message")
  appliedAt         DateTime?     @map("applied_at") @db.Timestamptz
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  rows              UploadRow[]
  errors            UploadError[]

  @@unique([tenantId, id])
  @@unique([tenantId, storageKey])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, source, status])
  @@map("uploads")
}

model UploadRow {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  uploadId       String  @map("upload_id") @db.Uuid
  upload         Upload  @relation(fields: [tenantId, uploadId], references: [tenantId, id], onDelete: Cascade)
  rowNumber      Int     @map("row_number")
  parsed         Json
  matchProductId String? @map("match_product_id") @db.Uuid
  changeType     String  @default("none") @map("change_type")

  @@unique([uploadId, rowNumber])
  @@index([tenantId, uploadId, changeType])
  @@map("upload_rows")
}

model UploadError {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  uploadId String  @map("upload_id") @db.Uuid
  upload   Upload  @relation(fields: [tenantId, uploadId], references: [tenantId, id], onDelete: Cascade)
  row      Int
  column   String?
  value    String?
  reason   String

  @@index([tenantId, uploadId])
  @@map("upload_errors")
}

// ───────────────────────── Recon & generated files ─────────────────────────

model ReconRow {
  id                         String   @id @default(uuid()) @db.Uuid
  tenantId                   String   @map("tenant_id") @db.Uuid
  tenant                     Tenant   @relation(fields: [tenantId], references: [id])
  productId                  String   @map("product_id") @db.Uuid
  product                    Product  @relation(fields: [tenantId, productId], references: [tenantId, id])
  marketplaceId              String   @map("marketplace_id")
  marketplacePrice           Decimal? @map("marketplace_price") @db.Decimal(12, 3)
  marketplacePriceSource     String?  @map("marketplace_price_source")
  erpPrice                   Decimal? @map("erp_price") @db.Decimal(12, 3)
  actualPrice                Decimal? @map("actual_price") @db.Decimal(12, 3)
  erpAvailable               Boolean? @map("erp_available")
  actualAvailable            Boolean? @map("actual_available")
  priceMismatchVsErp         Boolean  @default(false) @map("price_mismatch_vs_erp")
  priceMismatchVsMarketplace Boolean  @default(false) @map("price_mismatch_vs_marketplace")
  stockIssue                 String?  @map("stock_issue")
  /// Status against the MARKETPLACE reference (expected price = the resolved Marketplace price).
  status                     String
  /// Status against the ERP reference (expected price = the ERP price).
  statusVsErp                String   @default("no_data") @map("status_vs_erp")
  lastUpdated                DateTime @default(now()) @map("last_updated") @db.Timestamptz

  @@unique([tenantId, productId, marketplaceId])
  @@index([tenantId, marketplaceId, status])
  @@index([tenantId, marketplaceId, statusVsErp])
  @@map("recon_rows")
}

/// One row per tenant x marketplace x reference; the dashboard and the reports both read these rows.
model ReconSummary {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  marketplaceId  String    @map("marketplace_id")
  /// marketplace (expected = the resolved Marketplace price) | erp (expected = the ERP price)
  reference      String    @default("marketplace")
  listed         Int       @default(0)
  stock          Int       @default(0)
  price          Int       @default(0)
  total          Int       @default(0)
  notListed      Int       @default(0) @map("not_listed")
  noData         Int       @default(0) @map("no_data")
  missingFromErp Int       @default(0) @map("missing_from_erp")
  newCount       Int       @default(0) @map("new_count")
  hasData        Boolean   @default(false) @map("has_data")
  lastUploadAt   DateTime? @map("last_upload_at") @db.Timestamptz
  stale          Boolean   @default(false)
  computedAt     DateTime? @map("computed_at") @db.Timestamptz

  @@unique([tenantId, marketplaceId, reference])
  @@map("recon_summaries")
}

// Built-in upload formats. configured=false until the real marketplace file format is confirmed (Q10).
model OutputTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @map("marketplace_id")
  name          String
  version       Int      @default(1)
  columns       String[]
  configured    Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([marketplaceId, name, version])
  @@map("output_templates")
}

model GeneratedFile {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  marketplaceId String   @map("marketplace_id")
  kind          String // stock | price | stock_price | new_products
  scope         String // mismatches | all
  reference     String // erp | marketplace
  fileName      String   @map("file_name")
  storageKey    String   @map("storage_key")
  productCount  Int      @map("product_count")
  generatedById String   @map("generated_by_id") @db.Uuid
  generatedBy   User     @relation(fields: [tenantId, generatedById], references: [tenantId, id])
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz
  expiresAt     DateTime @map("expires_at") @db.Timestamptz

  @@index([tenantId, generatedAt(sort: Desc)])
  @@map("generated_files")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id])
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}
