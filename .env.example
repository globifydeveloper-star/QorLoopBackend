PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qorloop_dev
TENANT_ID=00000000-0000-0000-0000-000000000001
AUTH_SECRET=super-secret-development-key-32-chars-long
STORAGE_DIR=./storage
SMTP_HOST=localhost
SMTP_PORT=1025
CORS_ORIGIN=http://localhost:3000
BASE_DOMAIN=qorloop.globify.ae

# Redis (BullMQ upload processing)
REDIS_URL=redis://localhost:6379

# Private S3-compatible storage. Local development uses MinIO from docker-compose.
S3_BUCKET=qorloop-private
S3_REGION=me-central-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=qorloop
S3_SECRET_ACCESS_KEY=qorloop-dev-secret
UPLOAD_URL_TTL_SECONDS=600
# Uploads parsed in parallel by the worker (1-4); a worst-case 25 MB xlsx peaks at ~1.3 GB RSS
UPLOAD_CONCURRENCY=1
