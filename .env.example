PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qorloop_dev
# TENANT_ID pins a production instance to its one store and is required there. Outside production it is ignored:
# every active store resolves by the exact Host it is opened on (for example dohafresh.localhost, second.localhost).
# TENANT_ID=
AUTH_SECRET=super-secret-development-key-32-chars-long
STORAGE_DIR=./storage
# Mailpit in development (web inbox http://localhost:8025): sign-in codes arrive there (the worker must run).
# Production refuses to start without a real host and SMTP_USER/SMTP_PASSWORD; port 465 is implicit TLS (or set
# SMTP_SECURE=true), other ports must offer STARTTLS. SPF, DKIM and DMARC are set up at the mail provider.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=noreply@qorloop.globify.ae
MAIL_FROM_NAME=Qorloop
# Sessions (ADR 021): at most 20 days from sign-in and 7 days idle; lower only for testing.
# SESSION_MAX_DAYS=20
# SESSION_IDLE_DAYS=7
# Trusted browser origins. The hostname is replaced by the request's own host, so http://<any-store>.localhost:3000
# is trusted; only the scheme and port matter here. Invitation links use the store's hostname with this port.
APP_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BASE_DOMAIN=qorloop.globify.ae

# Redis (BullMQ upload processing)
REDIS_URL=redis://localhost:6379

# Private S3-compatible storage. Local development uses MinIO from docker-compose.
S3_BUCKET=qorloop-private
S3_REGION=me-central-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=qorloop
S3_SECRET_ACCESS_KEY=qorloop-dev-secret
UPLOAD_URL_TTL_SECONDS=600
# Uploads parsed in parallel by the worker (1-4); a worst-case 25 MB xlsx peaks at ~1.3 GB RSS
UPLOAD_CONCURRENCY=1
