{
  "name": "qorloop",
  "version": "0.2.0",
  "private": true,
  "engines": { "node": ">=22.12" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --noEmit false --emitDeclarationOnly false",
    "dev:api": "npm run dev -w @qorloop/api",
    "dev:worker": "npm run dev -w @qorloop/worker",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "db:generate": "npm run generate -w @qorloop/db",
    "db:migrate": "npm run migrate -w @qorloop/db",
    "db:migrate:dev": "npm run migrate:dev -w @qorloop/db",
    "db:seed": "npm run seed -w @qorloop/db",
    "provision:store": "tsx infra/provision-store.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
