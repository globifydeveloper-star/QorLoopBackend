{
  "name": "qorloop-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "overrides": {
    "fastify": "$fastify"
  },
  "main": "./dist/apps/api/src/main.js",
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand apps/api/src/__tests__",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages infra scripts --ignore-pattern packages/db/src/generated",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:studio": "prisma studio",
    "provision:store": "tsx infra/provision-store.ts",
    "api:spec": "tsx scripts/export-openapi.ts",
    "docker:up": "docker compose up -d postgres redis minio minio-init mailpit",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@hapi/iron": "^7.0.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.9.0",
    "bullmq": "^6.5.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "5.12.7",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@types/hapi__iron": "^5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jszip": "^3.10.2",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
