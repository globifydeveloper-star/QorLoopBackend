# Client __SLUG__ (generated by deploy/bin/qorloop client-add). Host is passed through unchanged: the API resolves the
# store from it, and storage verifies signed upload links against it.
__HOST__ {
	import qorloop_headers
	encode zstd gzip

	@api path /api/* /health /health/ready
	handle @api {
		reverse_proxy __SLUG__-api:4000
	}
	handle /__BUCKET__/* {
		reverse_proxy __SLUG__-storage:8333
	}
	handle {
		reverse_proxy __SLUG__-web:80
	}
}
